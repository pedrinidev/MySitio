---
import LogoMark from '../ui/LogoMark.astro';
import { useTranslations, alternateLanguage, ROUTES, localePath } from '../../lib/i18n';
import type { Language } from '../../lib/types';

interface Props {
  lang: Language;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const r = ROUTES[lang];
const other = alternateLanguage(lang);
const current = Astro.url.pathname;

const links = [
  { href: localePath(lang), label: t.nav.home },
  { href: localePath(lang, r.projects), label: t.nav.projects },
  { href: localePath(lang, r.blog), label: t.nav.blog },
  { href: localePath(lang, r.games), label: t.nav.games },
  { href: localePath(lang, r.about), label: t.nav.about },
];

const isActive = (href: string) =>
  href === localePath(lang) ? current === href : current.startsWith(href);
---

<header class="site-header">
  <div class="container-content header-inner">
    <a href={localePath(lang)} class="brand" aria-label="PedriniDev">
      <LogoMark />
      <span class="brand-name">PedriniDev</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label={t.nav.menu}>
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-contact">
          <a href={localePath(lang, r.contact)} class="nav-link">{t.nav.contact}</a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <!-- El selector de idioma es un enlace, no JavaScript: son dos URLs
           distintas y prerenderizadas. Un <select> con un listener sería
           más código para hacer exactamente lo mismo, peor.

           Visible dice «EN»/«ES»; el nombre accesible conserva la frase
           entera, porque dos letras sueltas no le dicen nada a quien
           navega con lector de pantalla. -->
      <a
        href={alternatePath}
        class="lang-switch"
        hreflang={other}
        lang={other}
        aria-label={t.common.switchTo}
      >
        {t.common.switchToShort}
      </a>
      {
        /* Conmutador de tema. Nace oculto y el script lo revela: sin
          JavaScript no podría hacer nada, y un botón que no responde es
          peor que un botón que no está. El sitio sigue respetando la
          preferencia del sistema en ese caso. */
      }
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label={t.common.theme}
        hidden
      >
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path
              d="M12 2.6v2.4M12 19v2.4M4.3 4.3l1.7 1.7M18 18l1.7 1.7M2.6 12H5M19 12h2.4M4.3 19.7L6 18M18 6l1.7-1.7"
            ></path>
          </g>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.2 14.4A8.4 8.4 0 1 1 9.6 3.8a6.9 6.9 0 0 0 10.6 10.6z" fill="currentColor"
          ></path>
        </svg>
      </button>

      <a href={localePath(lang, r.contact)} class="cta-small">{t.nav.contact}</a>

      <!-- El botón vive DESPUÉS del <nav> en el DOM pero se dibuja a su
           derecha. Si el JavaScript no llega, este botón queda oculto y el
           menú se muestra desplegado: nunca hay navegación inalcanzable. -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={t.nav.menu}
      >
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  /**
   * Menú móvil.
   *
   * Sin JavaScript el menú queda visible y apilado (ver la regla `.js` en
   * los estilos): se degrada a una lista de enlaces normal en vez de
   * desaparecer, que es lo que hacía antes por debajo de 900 px.
   */
  /* ── Tema ────────────────────────────────────────────────────
     El estado inicial ya lo dejó puesto el script del <head>. Aquí solo
     se revela el botón y se atiende el clic. */
  const themeButton = document.getElementById('theme-toggle');

  if (themeButton) {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

    /** Tema efectivo ahora mismo, venga de una elección o del sistema. */
    const currentTheme = () =>
      root.getAttribute('data-theme') ?? (systemDark.matches ? 'dark' : 'light');

    const reflect = () => {
      const dark = currentTheme() === 'dark';
      themeButton.setAttribute('aria-pressed', String(dark));
      // El icono anuncia a DÓNDE lleva pulsar, no dónde estás: en oscuro se
      // ve el sol, que es lo que vas a obtener.
      themeButton.classList.toggle('is-dark', dark);
    };

    themeButton.hidden = false;
    reflect();

    themeButton.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (error) {
        // Almacenamiento bloqueado: el cambio vale para esta página y ya.
      }
      reflect();
    });

    // Si nunca se eligió nada a mano, el sitio sigue al sistema en vivo.
    systemDark.addEventListener('change', () => {
      if (!root.hasAttribute('data-theme')) reflect();
    });
  }

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape cierra y devuelve el foco al botón, que es de donde salió.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Un clic fuera cierra. En un panel de navegación es lo que espera
    // cualquiera que haya usado un teléfono.
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    // Al navegar dentro del mismo idioma la página se recarga, pero con el
    // prefetch de Astro el panel puede quedar abierto un instante. Cerrarlo
    // al pulsar un enlace evita ese parpadeo.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    /* El logotipo mide 28 px; el enlace que lo envuelve necesita más alto
       para ser un objetivo cómodo con el dedo. */
    min-height: 2.75rem;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* El logotipo ya trae su forma y su color: nada de fondo ni de caja
     detrás. El ancho y el alto van en el HTML para que no salte el diseño
     mientras carga. */
  .nav-list {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 0.2s var(--ease-out-soft);
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-switch {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    /* 44 px de área táctil: el mínimo que recomienda Apple para el dedo. */
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.4rem;
    white-space: nowrap;
  }
  .lang-switch:hover {
    color: var(--color-accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out-soft),
      border-color 0.2s var(--ease-out-soft);
  }
  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-line-strong);
  }
  .theme-toggle svg {
    width: 1.05rem;
    height: 1.05rem;
    grid-area: 1 / 1;
  }
  /* Solo uno de los dos iconos se ve; el otro espera su turno. */
  .theme-toggle .icon-sun {
    display: none;
  }
  .theme-toggle.is-dark .icon-sun {
    display: block;
  }
  .theme-toggle.is-dark .icon-moon {
    display: none;
  }

  @media (pointer: coarse) {
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .cta-small {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: background 0.2s var(--ease-out-soft);
  }
  .cta-small:hover {
    background: var(--color-accent-hover);
  }

  /* El botón solo tiene sentido cuando hay algo que plegar: aparece cuando
     el JavaScript está vivo Y la pantalla es estrecha. */
  .nav-toggle {
    display: none;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    background: transparent;
    cursor: pointer;
  }
  /* Se llaman `nav-toggle-bar` y no `bar` por una colisión real: islands.css
     define un `.bar` GLOBAL para las barras de progreso del panel de métricas,
     con `margin-top: 0.9rem`. Los estilos con ámbito de Astro no impiden que
     una regla global coincida, y como aquí no se declaraba `margin-top`,
     ganaba la global: el icono aparecía 14,4 px por debajo del centro del
     botón. Un nombre propio cierra esa puerta.

     Las barras se posicionan absolutas sobre el centro exacto del botón y
     se separan desde ahí. Así, al abrir, basta con devolverlas al centro y
     girarlas para que formen una X perfecta; con `gap` en una rejilla cada
     barra vive en su propia fila y al girarlas salía un «›», no una cruz. */
  .nav-toggle-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1rem;
    height: 1.5px;
    /* El -50% vertical NO sobra: `top: 50%` alinea el BORDE superior de la
       barra con el centro del botón, no su centro. Sin él queda media
       altura por debajo. */
    margin-left: -0.5rem;
    margin-top: -0.75px;
    border-radius: 2px;
    background: var(--color-text);
    transition: transform 0.25s var(--ease-out-soft);
  }
  .nav-toggle-bar:first-of-type {
    transform: translateY(-4px);
  }
  .nav-toggle-bar:last-of-type {
    transform: translateY(4px);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:first-of-type {
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:last-of-type {
    transform: rotate(-45deg);
  }

  /* El botón del menú es el control más pulsado del sitio en un teléfono:
     merece el área táctil completa. */
  @media (pointer: coarse) {
    .nav-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* El nombre se muestra siempre: es la marca, y en la barra estrecha
     sobra sitio de todas formas una vez que «Contacto» se fue al panel. */
  .brand-name {
    display: inline;
  }

  @media (min-width: 900px) {
    .nav-contact {
      display: none;
    }
  }

  /* ── Por debajo de 900 px ──────────────────────────────────────────
     Antes de este bloque la navegación era `display: none` sin nada que
     la sustituyera: en un teléfono no había forma de llegar a Proyectos,
     Blog, Juegos ni Sobre mí. Ahora se convierte en un panel desplegable.  */
  @media (max-width: 899px) {
    .header-inner {
      flex-wrap: wrap;
      padding-block: 0.5rem;
      gap: 0.5rem;
    }

    /* El botón de contacto sale de la barra y entra en el panel: a 390 px
       la marca, el idioma, el botón y el conmutador no caben a la vez y
       algo se salía de la pantalla. Dentro del panel sigue estando a un
       toque de distancia. */
    .header-actions > .cta-small {
      display: none;
    }
    .nav-contact .nav-link {
      color: var(--color-accent);
      font-weight: 600;
    }

    /* Sin JavaScript: lista apilada siempre visible. */
    .site-nav {
      order: 3;
      width: 100%;
    }
    .nav-list {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--color-line);
      padding-top: 0.25rem;
    }
    .nav-link {
      display: block;
      min-height: 2.75rem;
      display: flex;
      align-items: center;
      font-size: 1rem;
    }

    /* Con JavaScript: plegado tras el botón. */
    :global(html.js-menu) .site-nav {
      display: none;
    }
    :global(html.js-menu) .site-nav.is-open {
      display: block;
    }
    :global(html.js-menu) .nav-toggle {
      display: grid;
    }
  }
</style>
