---
import { useTranslations, ROUTES, localePath } from '../../lib/i18n';
import { SITE_NAME } from '../../lib/site';
import type { Language } from '../../lib/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = ROUTES[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-content footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{SITE_NAME}</p>
      <p class="footer-note">{t.footer.builtWith}</p>
    </div>

    <nav class="footer-links" aria-label={t.nav.home}>
      <a href={localePath(lang, r.projects)}>{t.nav.projects}</a>
      <a href={localePath(lang, r.blog)}>{t.nav.blog}</a>
      <a href={localePath(lang, r.games)}>{t.nav.games}</a>
      <a href={localePath(lang, r.contact)}>{t.nav.contact}</a>
      <a href="https://github.com/pedrinidev" rel="noopener noreferrer" target="_blank">
        {t.footer.sourceCode}
      </a>
    </nav>

    <p class="footer-legal">© {year} {SITE_NAME}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface-alt);
    padding-block: 3rem 2.5rem;
    margin-top: var(--spacing-section);
  }

  .footer-inner {
    display: grid;
    gap: 1.75rem;
  }

  .footer-name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer-note {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 32rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    padding-block: 0.5rem; /* área táctil */
  }
  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-legal {
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .footer-legal {
      grid-column: 1 / -1;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-line);
    }
  }
</style>

<style>
  /* Los enlaces del pie miden 37 px de alto, por debajo del mínimo cómodo
     para el dedo. Solo se agrandan donde hace falta. */
  @media (pointer: coarse) {
    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }
</style>
