---
/**
 * Listado de juegos: una rejilla de tarjetas quietas.
 *
 * Antes esta página montaba TODOS los juegos a la vez, cada uno con su isla
 * y su ranking. Con dos juegos ya eran varios cientos de KB de JavaScript
 * para quien solo venía a mirar, y la página medía más de dos pantallas.
 *
 * Ahora se comporta como Proyectos: aquí solo hay tarjetas —cero
 * JavaScript— y el juego se carga al entrar en su página. Quien pasa de
 * largo no descarga ningún motor de juego.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/site';
import SectionHeading from '../ui/SectionHeading.astro';
import { getGames } from '../../lib/api';
import { useTranslations, ROUTES, localePath } from '../../lib/i18n';
import type { Language } from '../../lib/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Language = lang === 'es' ? 'en' : 'es';

const games = await getGames(lang);
const gamesBase = localePath(lang, ROUTES[lang].games);
---

<BaseLayout
  lang={lang}
  title={pageTitle(t.games.title)}
  description={t.games.subtitle}
  alternatePath={localePath(other, ROUTES[other].games)}
>
  <div class="section container-content">
    <SectionHeading
      level={1}
      eyebrow={t.nav.games}
      title={t.games.title}
      subtitle={t.games.subtitle}
    />

    {
      /* Mismas clases que las tarjetas de Proyectos: viven en el CSS global
        de islands.css, así que se ven idénticas sin duplicar estilos. Lo
        propio es la rejilla — aquí no hay carrusel ni desplazamiento. */
    }
    <ul class="games-grid">
      {
        games.map((game) => (
          <li class="card" data-reveal>
            <a href={`${gamesBase}/${game.slug}`} class="card-link">
              {game.cover_url ? (
                <img
                  src={game.cover_url}
                  alt=""
                  class="cover"
                  loading="lazy"
                  width={640}
                  height={400}
                />
              ) : (
                <div class="cover cover-placeholder" aria-hidden="true">
                  <span>{game.name.slice(0, 2).toUpperCase()}</span>
                </div>
              )}

              <div class="card-body">
                <h2 class="card-title">{game.name}</h2>
                <p class="card-tagline">{game.description}</p>
                <span class="card-cta">
                  {t.games.play}
                  <span aria-hidden="true"> →</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(21rem, 100%), 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .card-cta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
  }
</style>
