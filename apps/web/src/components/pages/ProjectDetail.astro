---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/site';
import TechBadge from '../ui/TechBadge.astro';
import { getProject } from '../../lib/api';
import { useTranslations, ROUTES, localePath } from '../../lib/i18n';
import type { Language } from '../../lib/types';

interface Props {
  lang: Language;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const other: Language = lang === 'es' ? 'en' : 'es';
const project = await getProject(slug, lang);

const linkLabels: Record<string, string> = {
  repo: t.projects.links.repo,
  live: t.projects.links.live,
  store: t.projects.links.store,
  video: t.projects.links.video,
};
---

<BaseLayout
  lang={lang}
  title={pageTitle(project.title)}
  description={project.summary}
  image={project.cover_url}
  alternatePath={`${localePath(other, ROUTES[other].projects)}/${slug}`}
>
  <article class="section">
    <header class="container-content project-header">
      <a href={localePath(lang, ROUTES[lang].projects)} class="back-link">
        ← {t.projects.backToList}
      </a>

      <p class="project-year" data-hero-item>{project.year}</p>
      <h1 class="project-title" data-hero-item>{project.title}</h1>
      <p class="project-tagline" data-hero-item>{project.tagline}</p>

      <ul class="badge-row" data-hero-item>
        {
          project.technologies.map((tech) => (
            <li>
              <TechBadge tech={tech} size="md" />
            </li>
          ))
        }
      </ul>

      {
        Object.keys(project.links).length > 0 && (
          <ul class="link-row" data-hero-item>
            {Object.entries(project.links).map(([key, url]) => (
              <li>
                <a href={url} rel="noopener noreferrer" target="_blank" class="project-link">
                  {linkLabels[key] ?? key} ↗
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      project.cover_url && (
        <div class="container-content project-cover" data-reveal>
          <img src={project.cover_url} alt="" width={1400} height={880} />
        </div>
      )
    }

    {
      project.metrics.length > 0 && (
        <div class="container-content">
          <dl class="metric-row" data-reveal>
            {project.metrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {
      project.role && (
        <div class="container-prose role-note" data-reveal>
          <p class="role-label">{t.projects.role}</p>
          <p class="role-value">{project.role}</p>
        </div>
      )
    }

    {
      /* El HTML viene renderizado y saneado desde Django (bleach con lista
        blanca). Ver apps/api/core/markdown.py. */
    }
    {
      project.body_html && (
        <div class="container-prose prose project-body" data-reveal set:html={project.body_html} />
      )
    }

    {
      project.images.length > 0 && (
        <div class="container-content gallery">
          {project.images.map((image) => (
            <figure data-reveal>
              {image.url && <img src={image.url} alt={image.caption} loading="lazy" />}
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }
  .back-link:hover {
    color: var(--color-accent);
  }

  .project-year {
    font-size: 0.875rem;
    color: var(--color-text-faint);
  }
  .project-title {
    margin-top: 0.5rem;
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }
  .project-tagline {
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 42rem;
  }

  .badge-row,
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
    list-style: none;
  }
  .link-row {
    gap: 0.75rem;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 1.1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: 0.875rem;
  }
  .project-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .project-cover {
    margin-top: 3.5rem;
  }
  .project-cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    display: block;
  }

  .metric-row {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-block: 2rem;
    border-block: 1px solid var(--color-line);
  }
  .metric-row dt {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .metric-row dd {
    margin-top: 0.4rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .role-note {
    margin-top: 3rem;
  }
  .role-label {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .role-value {
    margin-top: 0.4rem;
    font-size: 1.0625rem;
  }

  .project-body {
    margin-top: 3rem;
  }

  .gallery {
    display: grid;
    gap: 2rem;
    margin-top: 4rem;
  }
  .gallery img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    display: block;
  }
  .gallery figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-faint);
  }

  @media (min-width: 720px) {
    .metric-row {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
