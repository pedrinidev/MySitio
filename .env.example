# ─────────────────────────────────────────────────────────────
# Copiar a .env y rellenar. NUNCA versionar el .env real.
# Generar secretos con: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiame-en-produccion-openssl-rand-hex-32
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4321
# Ruta del panel de administración. NO la dejes en «admin/»: el repositorio
# es público, así que la ruta por defecto es la primera que prueba cualquier
# bot. Producción se niega a arrancar si no la cambiás.
#   openssl rand -hex 8      →  DJANGO_ADMIN_URL=9f3c1a7e4b2d8506/
DJANGO_ADMIN_URL=cambiame-openssl-rand-hex-8/

# --- CORS: lista blanca estricta del frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4321

# --- Rutas de datos persistentes (dentro del contenedor) ---
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static

# --- Secretos de aplicación ---
# Sal para hashear IPs. Nunca guardamos IPs en claro.
IP_HASH_SALT=cambiame-openssl-rand-hex-32
# Clave para firmar los tokens de sesión de los juegos (HMAC).
GAME_TOKEN_SECRET=cambiame-openssl-rand-hex-32

# ── Avisos del formulario de contacto ──────────────────────────────────
# DigitalOcean BLOQUEA los puertos de SMTP (25, 465, 587) en sus droplets.
# Con SMTP el formulario guarda los mensajes y el aviso muere en un «timed
# out» que solo se ve en los registros: parece que funciona y no funciona.
# Por eso el aviso sale por una API HTTPS, que viaja por el 443 como
# cualquier otra peticion.
#
# Canales, separados por comas: telegram, email, o los dos.
# Con dos, un canal caido no deja al otro sin enviar.
NOTIFY_CHANNELS=telegram

# ── Canal: Telegram ──
# No pide dominio verificado, ni registros DNS, ni cuenta de correo
# transaccional, y el aviso llega al telefono.
#
#   1. Escribile a @BotFather en Telegram y mandale /newbot
#   2. Copia el token que devuelve aqui abajo
#   3. Escribile CUALQUIER COSA a tu bot nuevo (si no, no hay conversacion
#      y el paso 4 sale vacio)
#   4. Abri https://api.telegram.org/bot<TOKEN>/getUpdates y copia el
#      numero de "chat":{"id":...}
TELEGRAM_BOT_TOKEN=cambiame-token-de-botfather
TELEGRAM_CHAT_ID=cambiame-id-numerico

# ── Canal: correo ──
# Solo hace falta si «email» esta en NOTIFY_CHANNELS.
# Para los dos a la vez: NOTIFY_CHANNELS=telegram,email
# Clave de Resend: https://resend.com/api-keys (3.000 correos/mes gratis).
# RESEND_API_KEY=re_cambiame
# Solo si desplegas en un proveedor que no bloquee SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=1
# EMAIL_HOST_USER=contacto@pedrinidev.com
# EMAIL_HOST_PASSWORD=contrasena-de-aplicacion-de-zoho
DEFAULT_FROM_EMAIL=contacto@pedrinidev.com
CONTACT_TO_EMAIL=pedrinidevs@gmail.com

# --- Token del proceso de build ---
# Exime al build de Astro del limite de peticiones de la API. Prerenderizar
# el sitio son ~22 peticiones en segundos desde una sola IP, y sin esto el
# despliegue se autobloquea con un 429.
# El MISMO valor va en el secreto BUILD_API_TOKEN de GitHub.
BUILD_API_TOKEN=cambiame-openssl-rand-hex-32

# --- Webhook de reconstrucción del sitio estático ---
# Token con permiso MÍNIMO (solo contents:write en este repositorio).
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=pedrinidev/mysite

# --- Métricas: rutas del host montadas en solo lectura ---
HOST_PROC_PATH=/host/proc
HOST_ROOT_PATH=/host/root

# --- Frontend ---
PUBLIC_API_URL=http://localhost:8000/api/v1
PUBLIC_SITE_URL=http://localhost:4321
